# ---- seleção dos trechos ----
CLIPFORGE_LLM_PROVIDER=anthropic      # anthropic | openai | ollama | heuristic
CLIPFORGE_LLM_MODEL=claude-sonnet-4-5
CLIPFORGE_TRIAGE_MODEL=
CLIPFORGE_REVIEW_MODEL=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# ---- transcrição ----
CLIPFORGE_WHISPER_MODEL=large-v3      # tiny|base|small|medium|large-v3
CLIPFORGE_WHISPER_DEVICE=auto         # auto|cuda|cpu
# 0 = decidir pela maquina (todos os nucleos no CPU, padrao da biblioteca na GPU)
CLIPFORGE_WHISPER_THREADS=0
# 0 = decidir pelo dispositivo (2 no CPU, 5 na GPU). Feixe maior custa tempo e,
# medido em fala em portugues, devolveu exatamente o mesmo texto.
CLIPFORGE_WHISPER_BEAM=0
# idioma: vazio = detectar automaticamente (comentário não pode ficar na mesma linha de valor vazio)
CLIPFORGE_LANGUAGE=

# ---- download por URL (YouTube) ----
CLIPFORGE_DOWNLOAD_MAX_HEIGHT=1080   # 2160 = crop mais nítido, download maior

# ---- clipes ----
CLIPFORGE_MAX_CLIPS=10
CLIPFORGE_MIN_DURATION=20
CLIPFORGE_MAX_DURATION=90

# ---- saída ----
CLIPFORGE_OUT_WIDTH=1080
CLIPFORGE_OUT_HEIGHT=1920
CLIPFORGE_CRF=19
CLIPFORGE_PRESET=medium
CLIPFORGE_VIDEO_ENCODER=auto            # auto | nvenc | qsv | amf | cpu
CLIPFORGE_CAPTION_SIZE=78
CLIPFORGE_CAPTION_HIGHLIGHT=&H0000E5FF
CLIPFORGE_INTERNAL_SILENCE_SECONDS=1.15

# ---- cortes de transmissão (Twitch, Kick, YouTube) ----
# Janela gravada de uma live em andamento. A gravação roda em tempo real.
CLIPFORGE_LIVE_MINUTES=30
CLIPFORGE_LIVE_MAX_MINUTES=120
# Acima desta duração o vídeo passa por garimpo antes de transcrever.
CLIPFORGE_PROSPECT_AFTER_MINUTES=25
# Contexto em segundos em volta de cada momento garimpado.
CLIPFORGE_PROSPECT_MARGIN=25

# ---- enquadramento vertical ----
# Faixa central do recorte onde o assunto precisa ficar (0,5 = metade central).
# Menor = enquadra mais colado no rosto; maior = deixa o rosto chegar perto da borda.
CLIPFORGE_SAFE_AREA=0.5
# Quanto a câmera puxa para o centro da imagem, sem nunca violar a área segura.
CLIPFORGE_CENTER_BIAS=0.25
# Segundos sem detectar rosto antes de segurar o enquadramento onde estava.
CLIPFORGE_HOLD_SECONDS=1.0
# Fração de segundos com rosto para confiar no rastreamento (abaixo disso, reanalisa o trecho).
CLIPFORGE_MIN_FACE_COVERAGE=0.35
# Desvio tolerado para trocar a perseguição por uma animação linear.
CLIPFORGE_LINEAR_TOLERANCE=0.08
# detecção de rosto por rede neural (melhor em rosto de lado e luz baixa):
# baixe face_detection_yunet_2023mar.onnx do OpenCV Zoo e aponte aqui
# CLIPFORGE_FACE_MODEL=C:\modelos\face_detection_yunet_2023mar.onnxace_detection_yunet_2023mar.onnx

# visão opcional: modelo OpenCV DNN e nomes das classes
# CLIPFORGE_OBJECT_MODEL=C:\modelos\frozen_inference_graph.pb
# CLIPFORGE_OBJECT_CONFIG=C:\modelos\ssd_mobilenet.pbtxt
# CLIPFORGE_OBJECT_LABELS=C:\modelos\coco.names

# ---- infra ----
CLIPFORGE_STORAGE=./storage

# YouTube OAuth (opcional: também pode importar o JSON na interface)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
