# ---- seleção dos trechos ----
CUTCLIPS_LLM_PROVIDER=anthropic      # anthropic | openai | ollama | heuristic
CUTCLIPS_LLM_MODEL=claude-sonnet-4-5
CUTCLIPS_TRIAGE_MODEL=
CUTCLIPS_REVIEW_MODEL=
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# ---- transcrição ----
CUTCLIPS_WHISPER_MODEL=large-v3      # tiny|base|small|medium|large-v3
CUTCLIPS_WHISPER_DEVICE=auto         # auto|cuda|cpu
# 0 = decidir pela maquina (todos os nucleos no CPU, padrao da biblioteca na GPU)
CUTCLIPS_WHISPER_THREADS=0
# 0 = decidir pelo dispositivo (2 no CPU, 5 na GPU). Feixe maior custa tempo e,
# medido em fala em portugues, devolveu exatamente o mesmo texto.
CUTCLIPS_WHISPER_BEAM=0
# idioma: vazio = detectar automaticamente (comentário não pode ficar na mesma linha de valor vazio)
CUTCLIPS_LANGUAGE=

# ---- download por URL (YouTube) ----
CUTCLIPS_DOWNLOAD_MAX_HEIGHT=1080   # 2160 = crop mais nítido, download maior

# ---- clipes ----
CUTCLIPS_MAX_CLIPS=10
CUTCLIPS_MIN_DURATION=20
CUTCLIPS_MAX_DURATION=90

# ---- saída ----
CUTCLIPS_OUT_WIDTH=1080
CUTCLIPS_OUT_HEIGHT=1920
CUTCLIPS_CRF=19
CUTCLIPS_PRESET=medium
CUTCLIPS_VIDEO_ENCODER=auto            # auto | nvenc | qsv | amf | cpu
CUTCLIPS_CAPTION_SIZE=78
CUTCLIPS_CAPTION_HIGHLIGHT=&H0000E5FF
CUTCLIPS_INTERNAL_SILENCE_SECONDS=1.15

# ---- cortes de transmissão (Twitch, Kick, YouTube) ----
# Janela gravada de uma live em andamento. A gravação roda em tempo real.
CUTCLIPS_LIVE_MINUTES=30
CUTCLIPS_LIVE_MAX_MINUTES=120
# Acima desta duração o vídeo passa por garimpo antes de transcrever.
CUTCLIPS_PROSPECT_AFTER_MINUTES=25
# Contexto em segundos em volta de cada momento garimpado.
CUTCLIPS_PROSPECT_MARGIN=25

# ---- enquadramento vertical ----
# Faixa central do recorte onde o assunto precisa ficar (0,5 = metade central).
# Menor = enquadra mais colado no rosto; maior = deixa o rosto chegar perto da borda.
CUTCLIPS_SAFE_AREA=0.5
# Quanto a câmera puxa para o centro da imagem, sem nunca violar a área segura.
CUTCLIPS_CENTER_BIAS=0.25
# Segundos sem detectar rosto antes de segurar o enquadramento onde estava.
CUTCLIPS_HOLD_SECONDS=1.0
# Fração de segundos com rosto para confiar no rastreamento (abaixo disso, reanalisa o trecho).
CUTCLIPS_MIN_FACE_COVERAGE=0.35
# Desvio tolerado para trocar a perseguição por uma animação linear.
CUTCLIPS_LINEAR_TOLERANCE=0.08
# detecção de rosto por rede neural (melhor em rosto de lado e luz baixa):
# baixe face_detection_yunet_2023mar.onnx do OpenCV Zoo e aponte aqui
# CUTCLIPS_FACE_MODEL=C:\modelos\face_detection_yunet_2023mar.onnxace_detection_yunet_2023mar.onnx

# visão opcional: modelo OpenCV DNN e nomes das classes
# CUTCLIPS_OBJECT_MODEL=C:\modelos\frozen_inference_graph.pb
# CUTCLIPS_OBJECT_CONFIG=C:\modelos\ssd_mobilenet.pbtxt
# CUTCLIPS_OBJECT_LABELS=C:\modelos\coco.names

# ---- infra ----
CUTCLIPS_STORAGE=./storage

# YouTube OAuth (opcional: também pode importar o JSON na interface)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# Geração local sem créditos. Instale ComfyUI e os pesos dos modelos no computador.
CUTCLIPS_COMFYUI_URL=http://127.0.0.1:8188
# Pasta do ComfyUI portátil; o Iniciar CutClips.cmd sobe o ComfyUI junto.
# CUTCLIPS_COMFYUI_DIR=C:/caminho/ComfyUI_windows_portable
# FLUX.2 Klein 4B FP8: arquivos em diffusion_models, text_encoders e vae do ComfyUI.
CUTCLIPS_FLUX_MODEL=flux-2-klein-4b-fp8.safetensors
CUTCLIPS_FLUX_TEXT_ENCODER=qwen_3_4b.safetensors
CUTCLIPS_FLUX_VAE=flux2-vae.safetensors
# Exporte fluxos locais Wan Animate e Hunyuan3D em formato API do ComfyUI.
# CUTCLIPS_WAN_WORKFLOW=C:\caminho\wan_animate_api.json
# CUTCLIPS_HUNYUAN3D_WORKFLOW=C:\caminho\hunyuan3d_api.json
